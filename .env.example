# Copy to .env (git-ignored). Placeholders only — never put a seed phrase here.
# Network: test (default, Zcash testnet) | main (WATCH-ONLY mainnet; Hisaab never calls pay there).
# Use a separate HISAAB_DATA_DIR per network — Hisaab refuses to mix them.
HISAAB_NETWORK=test
# GraphQL endpoint of the WATCH-ONLY zkool_graphql (holds only a viewing key: uivktest…/uviewtest…)
ZKOOL_URL=http://127.0.0.1:8002/graphql
# Name of the watch-only account Hisaab creates in that zkool
HISAAB_ACCOUNT_NAME=hisaab-watch
# Blocks before a payment counts as paid
HISAAB_CONFIRMATIONS=1
# Local UI port (always bound to 127.0.0.1)
HISAAB_PORT=4040
